{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".claude/**",
      "tests/**",
      "functions/**",
      "node_modules/**",
      "database.rules.json",
      ".firebase/**",
      "*.md"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
